# sample is a deterministic SEBI case study, not an LLM. Use live for arbitrary prompts.
FORMA_MODE=sample
FORMA_DATA_DIR=.data
FORMA_PLANTUML_JAR=.tools/plantuml.jar
# Live mode supports any OpenAI-compatible endpoint with tool calling.
FORMA_API_KEY=
FORMA_MODEL=gpt-4.1-mini
# FORMA_BASE_URL=https://api.openai.com/v1
# HTTPS deployment only:
# FORMA_COOKIE_SECURE=true

# Hosted PostgreSQL (leave unset for local SQLite):
# DATABASE_URL=postgresql://... pooled application connection
# DATABASE_URL_UNPOOLED=postgresql://... direct migration connection
# FORMA_DATA_DIR=/tmp/forma

# Free Gemini project (billing disabled), when opting into live mode:
# FORMA_MODEL=gemini-3.1-flash-lite
# FORMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FORMA_LIVE_DAILY_LIMIT=12
# FORMA_LIVE_GLOBAL_DAILY_LIMIT=150
