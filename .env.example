# sample is a deterministic SEBI case study, not an LLM. Use live for arbitrary prompts.
FORMA_MODE=sample
FORMA_DATA_DIR=.data
FORMA_PLANTUML_JAR=.tools/plantuml.jar
# Live mode supports any OpenAI-compatible endpoint with tool calling.
FORMA_API_KEY=
FORMA_MODEL=gpt-4.1-mini
# FORMA_BASE_URL=https://api.openai.com/v1
# HTTPS deployment only:
# FORMA_COOKIE_SECURE=true
